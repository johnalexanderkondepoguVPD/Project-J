# Project-J Environment Configuration
# Copy this file to .env and fill in the values

# ===== Application =====
APP_NAME="Project-J"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# ===== Server =====
HOST="0.0.0.0"
PORT=8000
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ===== Database =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_j"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_j_test"

# ===== PostgreSQL + pgvector =====
POSTGRES_DB="project_j"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ===== Security =====
SECRET_KEY="change-this-to-a-secure-random-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== AI / LLM =====
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ===== Storage (S3-compatible) =====
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio123"
S3_BUCKET_NAME="project-j"
S3_REGION="us-east-1"

# ===== Caching =====
CACHE_TTL_SECONDS=3600

# ===== Scraping =====
SCRAPING_TIMEOUT=30
MAX_RETRIES=3
USER_AGENT="Project-J-Scraper/1.0"

# ===== OCR =====
PADDLE_OCR_URL="http://localhost:8080"
PADDLE_OCR_API_KEY=""

# ===== Celery =====
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
CELERY_TIMEZONE="UTC"
CELERYBeat_SCHEDULE_INTERVAL=30